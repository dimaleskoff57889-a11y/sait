import type { Metadata } from "next";
import Link from "next/link";
import { site, has } from "@/content/site";
import { DraftBanner } from "@/components/DraftBanner";

export const metadata: Metadata = {
  title: ["Политика обработки персональных данных", site.legal.shortName].filter(has).join(" — "),
  robots: site.draft ? { index: false, follow: false } : undefined,
};

/**
 * Политика обработки персональных данных (152-ФЗ, ч. 2 ст. 18.1).
 *
 * Структура и формулировки взяты из политики REPETITORLY, которая проходила
 * юриста, и переписаны под то, что реально происходит здесь: сайт без форм,
 * cookie и аналитики, связь по телефону и в мессенджерах, договоры подряда.
 *
 * ⚠️ ТЕКСТ НЕ СОГЛАСОВАН С ЮРИСТОМ. Вопросы к нему — в SITE.md, раздел
 * «Политика обработки ПДн». Реквизиты подставляются из site.legal; пока их
 * нет, на их месте прочерки.
 *
 * Если на сайт добавят форму заявки или Яндекс Метрику — политику обязательно
 * дополнить (новая цель обработки, cookie), иначе она перестанет быть правдой.
 */

const BLANK = "__________";
const or = (value: string) => (has(value) ? value : BLANK);

function Section({ title, children }: { title: string; children: React.ReactNode }) {
  return (
    <section>
      <h2 className="text-base font-semibold text-steel-900">{title}</h2>
      <div className="mt-3 space-y-3">{children}</div>
    </section>
  );
}

function List({ items }: { items: React.ReactNode[] }) {
  return (
    <ul className="list-disc space-y-1.5 pl-5 marker:text-steel-300">
      {items.map((item, i) => (
        <li key={i}>{item}</li>
      ))}
    </ul>
  );
}

/** Карточка цели обработки: цель, основание, данные, субъекты, действия, способ, срок. */
function Purpose({ title, rows }: { title: string; rows: [string, string][] }) {
  return (
    <div className="rounded-xl border border-steel-200 bg-steel-50/60">
      <h3 className="border-b border-steel-200 px-4 py-3 text-sm font-semibold text-steel-900">
        {title}
      </h3>
      <dl className="divide-y divide-steel-200/70">
        {rows.map(([label, value]) => (
          <div key={label} className="grid gap-1 px-4 py-2.5 sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-4">
            <dt className="text-xs font-semibold text-steel-500">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  );
}

const ACTIONS_FULL =
  "Сбор; запись; систематизация; накопление; хранение; уточнение (обновление, изменение); извлечение; использование; передача (предоставление, доступ); блокирование; удаление; уничтожение";

export default function PrivacyPage() {
  const { form, fullName, inn, ogrnip, address, policyDate } = site.legal;
  const { phoneDisplay, email } = site.contacts;
  const operator = has(fullName) ? [form, fullName].filter(has).join(" ") : BLANK;
  const siteRef = has(site.url) ? site.url : "сайт, на котором размещена настоящая Политика";

  return (
    <>
      <DraftBanner />
      <div className="min-h-screen bg-white">
        <div className="mx-auto w-full max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
          <Link href="/" className="text-sm text-steel-500 hover:text-steel-900">
            ← На главную
          </Link>

          <h1 className="mt-6 text-2xl font-bold tracking-tight text-steel-900 sm:text-3xl">
            Политика обработки персональных данных
          </h1>
          <p className="mt-2 text-sm text-steel-400">Редакция от {or(policyDate)}</p>

          <div className="mt-10 space-y-10 text-sm leading-relaxed text-steel-700">
            <Section title="1. Общие положения">
              <p>
                1.1. Настоящая Политика определяет политику {operator} (далее — Оператор) в
                отношении обработки персональных данных и разработана в соответствии с Федеральным
                законом от 27.07.2006 № 152-ФЗ «О персональных данных» (далее — 152-ФЗ).
              </p>
              <p>1.2. Политика распространяется на обработку персональных данных Оператором:</p>
              <List
                items={[
                  "при посещении Сайта;",
                  "при обращении к Оператору по телефону и в мессенджерах, указанных на Сайте;",
                  "при заключении и исполнении договоров на монтаж, демонтаж, ремонт, модернизацию и обслуживание подъёмного оборудования.",
                ]}
              />
              <p>1.3. Сведения об Операторе:</p>
              <List
                items={[
                  `Оператор: ${operator}`,
                  `ИНН: ${or(inn)}`,
                  `ОГРНИП: ${or(ogrnip)}`,
                  `Адрес для направления корреспонденции: ${or(address)}`,
                  `Телефон: ${phoneDisplay}`,
                  ...(has(email) ? [`Электронная почта: ${email}`] : []),
                ]}
              />
              <p>
                1.4. Оператор является индивидуальным предпринимателем, лично организует обработку
                персональных данных и обеспечивает выполнение обязанностей, предусмотренных 152-ФЗ.
              </p>
              <p>
                1.5. Обработка персональных данных осуществляется с использованием средств
                автоматизации, без их использования либо смешанным способом — в зависимости от цели
                обработки, указанной в разделе 4.
              </p>
              <p>
                1.6. Политика является общедоступным документом. Неограниченный доступ к ней
                обеспечивается размещением на Сайте в соответствии с частью 2 статьи 18.1 152-ФЗ.
              </p>
            </Section>

            <Section title="2. Основные понятия">
              <List
                items={[
                  "Персональные данные — любая информация, относящаяся к прямо или косвенно определённому или определяемому физическому лицу (Субъекту персональных данных, далее — Субъект).",
                  "Оператор — лицо, самостоятельно организующее и осуществляющее обработку персональных данных, а также определяющее цели обработки, состав персональных данных и действия с ними.",
                  "Обработка персональных данных — любое действие или совокупность действий с персональными данными, совершаемых с использованием средств автоматизации или без них, включая сбор, запись, систематизацию, накопление, хранение, уточнение, извлечение, использование, передачу, обезличивание, блокирование, удаление и уничтожение.",
                  "Предоставление персональных данных — действия, направленные на раскрытие персональных данных определённому лицу или определённому кругу лиц.",
                  "Трансграничная передача персональных данных — передача персональных данных на территорию иностранного государства органу власти иностранного государства, иностранному физическому или юридическому лицу.",
                  `Сайт — ${siteRef}.`,
                ]}
              />
            </Section>

            <Section title="3. Принципы обработки">
              <p>Оператор обрабатывает персональные данные в соответствии со статьёй 5 152-ФЗ:</p>
              <List
                items={[
                  "на законной и справедливой основе;",
                  "только для достижения конкретных, заранее определённых и законных целей;",
                  "в объёме, который соответствует целям обработки и не является избыточным;",
                  "с обеспечением точности, достаточности и актуальности персональных данных;",
                  "не дольше, чем этого требуют цели обработки, если иной срок не установлен федеральным законом или договором; по достижении целей персональные данные уничтожаются.",
                ]}
              />
            </Section>

            <Section title="4. Цели, основания и условия обработки">
              <p>
                Для каждой цели ниже указаны правовое основание, условие обработки по 152-ФЗ, состав
                данных, категории Субъектов, действия, способ и срок обработки.
              </p>

              <Purpose
                title="4.1. Ответ на обращение и подготовка договора"
                rows={[
                  [
                    "Цель",
                    "Ответить на звонок или сообщение, обсудить задачу, объём работ, сроки и стоимость, подготовить договор",
                  ],
                  [
                    "Правовое основание",
                    "Обращение Субъекта по собственной инициативе с целью заключить договор; законный интерес Оператора в ответе на обращение представителя организации",
                  ],
                  ["Условие по 152-ФЗ", "Пункты 5 и 7 части 1 статьи 6 152-ФЗ"],
                  [
                    "Персональные данные",
                    "Имя, которым представился Субъект; номер телефона; имя пользователя и идентификатор в мессенджере; содержание обращения и переписки; сведения об объекте и оборудовании; фотографии и документы, если Субъект их направил; должность и наименование организации, если Субъект её представляет",
                  ],
                  [
                    "Категории Субъектов",
                    "Лица, обратившиеся к Оператору, в том числе представители организаций",
                  ],
                  ["Действия", ACTIONS_FULL],
                  ["Способ", "Смешанная обработка"],
                  [
                    "Срок",
                    "Если договор заключён — далее по цели 4.2. Если договор не заключён — 3 года с даты последнего сообщения по обращению",
                  ],
                ]}
              />

              <Purpose
                title="4.2. Заключение и исполнение договора"
                rows={[
                  [
                    "Цель",
                    "Заключить и исполнить договор на монтаж, демонтаж, ремонт, модернизацию и обслуживание подъёмного оборудования; согласовать доступ на объект; принять оплату; исполнить гарантийные обязательства",
                  ],
                  [
                    "Правовое основание",
                    "Договор, стороной которого является Субъект; законный интерес Оператора и заказчика — организации во взаимодействии с её представителями; обязанности Оператора по законодательству о налогах и сборах",
                  ],
                  ["Условие по 152-ФЗ", "Пункты 2, 5 и 7 части 1 статьи 6 152-ФЗ"],
                  [
                    "Персональные данные",
                    "ФИО; должность и организация; номер телефона; адрес электронной почты; реквизиты, указанные в договоре; паспортные данные — если заказчик является физическим лицом и договор их требует; адрес объекта; сведения, необходимые для доступа на объект; подпись в договоре и актах; сведения об оплате",
                  ],
                  [
                    "Категории Субъектов",
                    "Заказчики — физические лица и индивидуальные предприниматели; представители заказчиков — организаций",
                  ],
                  ["Действия", ACTIONS_FULL],
                  ["Способ", "Смешанная обработка"],
                  [
                    "Срок",
                    "Срок действия договора и гарантийный срок; после этого — в течение сроков хранения документов, установленных законодательством Российской Федерации о налогах и сборах",
                  ],
                ]}
              />

              <Purpose
                title="4.3. Работа Сайта"
                rows={[
                  ["Цель", "Показ страниц Сайта, обеспечение его работоспособности и защиты от атак"],
                  [
                    "Правовое основание",
                    "Законный интерес Оператора в работоспособности и безопасности Сайта",
                  ],
                  ["Условие по 152-ФЗ", "Пункт 7 части 1 статьи 6 152-ФЗ"],
                  [
                    "Персональные данные",
                    "IP-адрес; сведения о браузере и устройстве; адрес запрошенной страницы; дата и время запроса — в объёме, который браузер передаёт автоматически",
                  ],
                  ["Категории Субъектов", "Посетители Сайта"],
                  ["Действия", "Сбор; запись; хранение; использование; удаление; уничтожение"],
                  ["Способ", "Автоматизированная обработка"],
                  [
                    "Срок",
                    "В течение срока хранения технических журналов хостинг-провайдера. Оператор не использует эти данные для установления личности посетителей и не объединяет их с другими данными",
                  ],
                ]}
              />
            </Section>

            <Section title="5. Файлы cookie и аналитика">
              <p>
                5.1. Сайт не использует файлы cookie, счётчики и сервисы веб-аналитики (в том числе
                Яндекс Метрику), не содержит форм для ввода персональных данных и не загружает
                шрифты и скрипты со сторонних серверов.
              </p>
              <p>
                5.2. Если это изменится, Оператор дополнит Политику до начала такой обработки и, если
                этого требует закон, получит согласие Субъекта.
              </p>
            </Section>

            <Section title="6. Передача персональных данных третьим лицам">
              <p>
                6.1. Оператор предоставляет персональные данные третьим лицам или поручает их
                обработку только при наличии законного основания и в объёме, необходимом для
                конкретной цели.
              </p>
              <p>
                6.2. Хостинг Сайта: ООО «ТАЙМВЭБ.КЛАУД», 420500, Республика Татарстан, м.р-н
                Верхнеуслонский, г.п. город Иннополис, г. Иннополис, ул. Университетская, д. 7, оф.
                605. Место обработки — Москва, Российская Федерация. Обрабатывает технические данные,
                указанные в пункте 4.3, по поручению Оператора.
              </p>
              <p>
                6.3. Специалисты, которых Оператор привлекает к выполнению работ по договору,
                получают имя и телефон контактного лица заказчика и адрес объекта — в объёме,
                необходимом для выполнения работ.
              </p>
              <p>
                6.4. Если Субъект пишет Оператору в мессенджере Telegram или MAX, переписка также
                обрабатывается владельцем соответствующего мессенджера по его правилам. Мессенджер
                Telegram принадлежит иностранной компании. Субъект, который не хочет использовать
                иностранный сервис, может позвонить Оператору по телефону или написать в MAX.
              </p>
              <p>
                6.5. Оператор предоставляет персональные данные государственным органам в случаях и
                порядке, предусмотренных законодательством Российской Федерации.
              </p>
            </Section>

            <Section title="7. Трансграничная передача">
              <p>
                7.1. Оператор обрабатывает и хранит персональные данные на территории Российской
                Федерации и не передаёт их иностранным лицам, за исключением случая, описанного в
                пункте 6.4, когда Субъект сам выбирает для связи мессенджер Telegram.
              </p>
            </Section>

            <Section title="8. Меры по обеспечению безопасности">
              <p>
                8.1. Оператор принимает правовые, организационные и технические меры, предусмотренные
                статьями 18.1 и 19 152-ФЗ, с учётом характера и объёма обрабатываемых данных:
              </p>
              <List
                items={[
                  "лично организует обработку персональных данных и определяет, кто имеет к ним доступ;",
                  "допускает к данным заказчиков только лиц, участвующих в выполнении работ, и только в необходимом объёме;",
                  "защищает устройства, на которых хранятся контакты и переписка, паролем или иным способом блокировки;",
                  "хранит бумажные договоры и акты в месте, недоступном посторонним;",
                  "использует для Сайта защищённое соединение (HTTPS) и не собирает данные через формы;",
                  "уничтожает персональные данные по истечении сроков обработки.",
                ]}
              />
              <p>
                8.2. При неправомерной или случайной передаче, предоставлении, распространении
                персональных данных или доступе к ним, повлёкших нарушение прав Субъектов, Оператор
                уведомляет Роскомнадзор: в течение 24 часов — об инциденте, его предполагаемых
                причинах, вреде и принятых мерах; в течение 72 часов — о результатах внутреннего
                расследования.
              </p>
            </Section>

            <Section title="9. Права Субъекта и порядок обращений">
              <p>9.1. Субъект вправе:</p>
              <List
                items={[
                  "получить сведения об обработке своих персональных данных (статья 14 152-ФЗ);",
                  "потребовать уточнения, блокирования или уничтожения данных, если они неполные, устаревшие, неточные, незаконно получены или не нужны для заявленной цели (статьи 14, 20 и 21 152-ФЗ);",
                  "отозвать согласие, если обработка основана на согласии (часть 2 статьи 9 152-ФЗ);",
                  "потребовать прекращения обработки, кроме случаев, когда Оператор вправе продолжить её без согласия (часть 5.1 статьи 21 152-ФЗ);",
                  "обжаловать действия или бездействие Оператора в Роскомнадзор или в суд (статья 17 152-ФЗ).",
                ]}
              />
              <p>
                9.2. Обращение можно направить письмом по адресу {or(address)}
                {has(email) ? `, на электронную почту ${email}` : ""} или сообщить о нём по телефону{" "}
                {phoneDisplay}. Обращение должно позволять определить Субъекта и содержание его
                требования; Оператор вправе запросить сведения, подтверждающие личность заявителя.
              </p>
              <p>
                9.3. Запрос о предоставлении сведений по статье 14 152-ФЗ должен содержать номер
                документа, удостоверяющего личность Субъекта или его представителя, сведения о дате
                его выдачи и выдавшем органе, сведения, подтверждающие участие Субъекта в отношениях с
                Оператором, и подпись Субъекта или его представителя.
              </p>
              <p>9.4. Сроки рассмотрения:</p>
              <List
                items={[
                  "предоставление сведений или мотивированный отказ — 10 рабочих дней (может быть продлён не более чем на 5 рабочих дней с мотивированным уведомлением);",
                  "уточнение данных, уничтожение незаконно полученных или не необходимых для цели данных — 7 рабочих дней со дня предоставления подтверждающих сведений;",
                  "прекращение обработки по требованию Субъекта — 10 рабочих дней (может быть продлён не более чем на 5 рабочих дней с мотивированным уведомлением).",
                ]}
              />
            </Section>

            <Section title="10. Сроки обработки и уничтожение">
              <p>
                10.1. Срок обработки определяется для каждой цели в разделе 4. По достижении цели
                Оператор прекращает обработку и уничтожает персональные данные в срок, не превышающий
                30 дней, если иное не предусмотрено договором или федеральным законом.
              </p>
              <p>
                10.2. При выявлении неправомерной обработки Оператор прекращает её в срок, не
                превышающий 3 рабочих дней, а если обеспечить правомерность невозможно — уничтожает
                данные в срок, не превышающий 10 рабочих дней с даты выявления.
              </p>
              <p>
                10.3. Если уничтожить данные в установленный срок невозможно, Оператор блокирует их и
                уничтожает в срок не более 6 месяцев, если иной срок не установлен федеральным
                законом.
              </p>
            </Section>

            <Section title="11. Прочие условия">
              <p>
                11.1. Сайт и услуги Оператора предназначены для организаций и совершеннолетних лиц.
                Оператор не обрабатывает специальные категории и биометрические персональные данные.
              </p>
              <p>
                11.2. Оператор пересматривает Политику при изменении законодательства, целей, состава
                данных или способов обработки. Действующая редакция постоянно доступна на Сайте, дата
                редакции указана в начале документа.
              </p>
            </Section>
          </div>
        </div>
      </div>
    </>
  );
}
